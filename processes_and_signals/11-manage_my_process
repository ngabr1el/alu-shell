#!/usr/bin/env bash
# Init script that starts, stops and restarts manage_my_process

PID_FILE="/var/run/my_process.pid"
DIR="$(dirname "$0")"

start() {
    nohup "$DIR/manage_my_process" > /dev/null 2>&1 &
    echo "$!" > "$PID_FILE"
}

stop() {
    if [ -f "$PID_FILE" ]
    then
        kill "$(cat "$PID_FILE")" 2>/dev/null
        rm -f "$PID_FILE"
    fi
    pkill -f '/manage_my_process'
}

case "$1" in
    start)
        start
        echo "manage_my_process started"
        ;;
    stop)
        stop
        echo "manage_my_process stopped"
        ;;
    restart)
        stop
        start
        echo "manage_my_process restarted"
        ;;
    *)
        echo "Usage: manage_my_process {start|stop|restart}"
        ;;
esac
